# Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# MongoDB Connection (Falls back seamlessly to local atomic storage if MongoDB is not running)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=triageai

# Model Storage Directory
MODEL_DIR=backend/trained_models

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Web Client Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google Maps Platform (Places & Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

